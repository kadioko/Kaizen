{
  "name": "tofauti",
  "private": true,
  "workspaces": ["apps/web", "packages/shared-types"],
  "scripts": {
    "dev:web": "npm run dev --workspace @tofauti/web",
    "build:web": "npm run build --workspace @tofauti/web",
    "lint:web": "npm run lint --workspace @tofauti/web",
    "typecheck:web": "npm run typecheck --workspace @tofauti/web",
    "test:api": "python -m pytest tests -q",
    "dev:api": "python -m uvicorn app.main:app --app-dir apps/api --reload --port 8000"
  }
}

