DEMO_MODE=true
ALLOW_DEMO_CONTROLS=false
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,https://tofauti.vercel.app
# Optional public FastAPI/WebSocket origin for the Next.js client. Leave blank until the hosted engine reports a live provider.
NEXT_PUBLIC_API_URL=
MARKET_DATA_PROVIDER=mock
# Required only when MARKET_DATA_PROVIDER=databento and DEMO_MODE=false. This
# must be an entitled server-only key for CME Globex / COMEX futures data.
DATABENTO_API_KEY=
DATABENTO_DATASET=GLBX.MDP3
# MBP-1 supports top-of-book plus trades. MBP-10 is required before the
# market-by-price depth ladder can be shown. MBO is deliberately unsupported.
DATABENTO_SCHEMA=mbp-1
# GC and MGC are the active default. NQ/MNQ need an explicit production-only
# activation plus verified, entitled parent symbols from the operator.
TOFAUTI_FUTURES=GC,MGC
DATABENTO_PARENT_SYMBOLS=GC=GC.FUT,MGC=MGC.FUT
# Licensed full calendar; it is timing/risk context, not directional macro.
ECONOMIC_CALENDAR_PROVIDER=none
TRADING_ECONOMICS_API_KEY=
CALENDAR_COUNTRIES=united states
DATABASE_URL=postgresql://tofauti:tofauti@localhost:5432/tofauti
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false
# Server-only values. Never provide SUPABASE_SERVICE_ROLE_KEY to Next.js or commit it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Server-only Twelve Data key for the XAU/USD spot reference. This does not enable CME futures or order-flow data.
TWELVE_DATA_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
